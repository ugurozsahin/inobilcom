---
/**
 * Inline INOBIL wordmark. The SVG uses currentColor, so it follows the text colour
 * of its parent and works in both light and dark themes.
 * Source of truth: src/assets/brand/inobil-wordmark-currentcolor.svg (outlined paths, no font dependency).
 */
import wordmark from '../assets/brand/inobil-wordmark-currentcolor.svg?raw';

interface Props {
  /** Rendered height in pixels; width follows the SVG aspect ratio. */
  height?: number;
  class?: string;
}

const { height = 18, class: className = '' } = Astro.props;
---

<span class={`logo ${className}`} style={`--logo-h:${height}px`} set:html={wordmark} />

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    line-height: 0;
  }
  .logo :global(svg) {
    height: var(--logo-h);
    width: auto;
    display: block;
  }
</style>
