---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
  index: number;
}

const { project, index } = Astro.props;
const { title, client, country, summary, tags, cover } = project.data;
const href = `/work/${project.id}/`;
---

<article class="card glass">
  <a class="shot" href={href} aria-label={`${title} — details`}>
    <Image src={cover} alt={`Screenshot of ${title}`} width={720} densities={[1, 2]} loading={index < 3 ? 'eager' : 'lazy'} />
  </a>
  <div class="body">
    <div class="meta">
      <span class="num gradient-text">{String(index + 1).padStart(2, '0')}</span>
      <span class="client">{client} · {country}</span>
    </div>
    <h3><a href={href}>{title}</a></h3>
    <p>{summary}</p>
    {tags.length > 0 && <div class="tags">{tags.map((t) => <span class="tag">{t}</span>)}</div>}
  </div>
</article>

<style>
  .card {
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 10px 40px -20px var(--shadow);
    transition: transform 0.2s, box-shadow 0.2s;
    display: flex;
    flex-direction: column;
  }
  .card:hover {
    transform: translateY(-4px);
    box-shadow: 0 24px 50px -24px var(--shadow);
  }
  .shot {
    display: block;
    margin: 10px 10px 0;
    border-radius: 12px;
    border: 1px solid var(--line);
    overflow: hidden;
    aspect-ratio: 16 / 10;
    background: var(--bg);
  }
  .shot :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }
  .body {
    padding: 18px 20px 22px;
  }
  .meta {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--mute);
    margin-bottom: 8px;
  }
  h3 {
    font-size: 20px;
    margin-bottom: 8px;
    letter-spacing: -0.01em;
  }
  p {
    font-size: 14px;
    line-height: 1.55;
    color: var(--mute);
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 12px;
  }
</style>
