---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page not found">
  <section class="nf">
    <div class="wrap">
      <p class="code gradient-text">404</p>
      <h1>Page not found</h1>
      <p>The page you are looking for does not exist.</p>
      <a class="home glass" href="/">Back to home</a>
    </div>
  </section>
</Layout>

<style>
  .nf {
    padding: 120px 0;
    text-align: center;
  }
  .code {
    font-size: 72px;
    font-weight: 800;
    letter-spacing: -0.04em;
  }
  h1 {
    font-size: 32px;
    letter-spacing: -0.02em;
    margin: 8px 0 12px;
  }
  p {
    color: var(--mute);
  }
  .home {
    display: inline-block;
    margin-top: 28px;
    padding: 10px 18px;
    border-radius: 999px;
    font-weight: 600;
  }
</style>
