---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import { breadcrumbSchema, projectSchema } from '../../lib/schema';
import { site } from '../../data/site';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => !data.draft);
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { title, client, country, summary, tags, cover } = project.data;
const { Content } = await render(project);
const pageUrl = new URL(`/work/${project.id}/`, Astro.site).toString();
const schema = [
  projectSchema({ url: pageUrl, title, summary, client, country, tags, image: new URL(cover.src, Astro.site).toString() }),
  breadcrumbSchema([
    { name: site.name, url: new URL('/', Astro.site).toString() },
    { name: site.work.heading, url: new URL('/#work', Astro.site).toString() },
    { name: title, url: pageUrl },
  ]),
];
---

<Layout title={title} description={summary} schema={schema}>
  <article class="project">
    <div class="wrap">
      <a class="back" href="/#work">← All work</a>
      <p class="client">{client} · {country}</p>
      <h1>{title}</h1>
      <p class="summary">{summary}</p>
      {tags.length > 0 && <div class="tags">{tags.map((t) => <span class="tag">{t}</span>)}</div>}
      <div class="cover glass">
        <Image src={cover} alt={`Screenshot of ${title}`} width={1440} densities={[1, 2]} loading="eager" />
      </div>
      <div class="prose">
        <Content />
      </div>
    </div>
  </article>
</Layout>

<style>
  .project {
    padding: 56px 0 80px;
  }
  .back {
    display: inline-block;
    color: var(--mute);
    font-weight: 500;
    margin-bottom: 36px;
  }
  .back:hover {
    color: var(--fg);
  }
  .client {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--mute);
    margin-bottom: 10px;
  }
  h1 {
    font-size: clamp(34px, 5vw, 56px);
    letter-spacing: -0.035em;
    font-weight: 800;
    line-height: 1.05;
  }
  .summary {
    margin-top: 18px;
    font-size: clamp(17px, 2vw, 20px);
    line-height: 1.6;
    color: var(--mute);
    max-width: 760px;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 18px;
  }
  .cover {
    margin: 40px 0 44px;
    border-radius: 20px;
    padding: 10px;
    box-shadow: 0 24px 60px -30px var(--shadow);
  }
  .cover :global(img) {
    border-radius: 12px;
    border: 1px solid var(--line);
    width: 100%;
    height: auto;
  }
</style>
