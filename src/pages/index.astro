---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { site } from '../data/site';

const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
const githubHandle = site.contact.github.replace(/^https?:\/\//, '');
const linkedinHandle = site.contact.linkedin.replace(/^https?:\/\//, '').replace(/\/$/, '');
---

<Layout>
  <section class="hero">
    <div class="wrap hero-inner">
      <p class="eyebrow glass">{site.hero.eyebrow}</p>
      <h1>{site.hero.headline}</h1>
      <p class="lead">{site.hero.lead}</p>
      <ul class="services">
        {site.services.map((s) => <li class="glass">{s}</li>)}
      </ul>
    </div>
  </section>

  <section id="work">
    <div class="wrap">
      <div class="sec-head">
        <h2>{site.work.heading}</h2>
        <p>{site.work.intro}</p>
      </div>
      <div class="grid">
        {projects.map((project, index) => <ProjectCard project={project} index={index} />)}
      </div>
    </div>
  </section>

  <section id="about">
    <div class="wrap">
      <div class="sec-head"><h2>{site.about.heading}</h2></div>
      <div class="about-body">
        <p>{site.about.body}</p>
        <div class="who glass">
          <strong>{site.about.person}</strong>
          <span>{site.about.title}</span>
        </div>
      </div>
    </div>
  </section>

  <section id="contact">
    <div class="wrap">
      <div class="sec-head">
        <h2>{site.contact.heading}</h2>
        <p>{site.contact.intro}</p>
      </div>
      <div class="contacts">
        <a class="c glass" href={`mailto:${site.contact.email}`}>
          <span class="k">Email</span><span class="v">{site.contact.email}</span>
        </a>
        <a class="c glass" href={site.contact.github} rel="me noopener">
          <span class="k">GitHub</span><span class="v">{githubHandle}</span>
        </a>
        <a class="c glass" href={site.contact.linkedin} rel="me noopener">
          <span class="k">LinkedIn</span><span class="v">{linkedinHandle}</span>
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero {
    padding: 96px 0 72px;
    text-align: center;
  }
  @media (min-width: 640px) {
    .hero {
      padding: 120px 0 90px;
    }
  }
  .hero-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .eyebrow {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 8px 14px;
    border-radius: 999px;
    margin-bottom: 28px;
  }
  h1 {
    font-size: clamp(40px, 7vw, 76px);
    line-height: 1.02;
    letter-spacing: -0.04em;
    font-weight: 800;
    max-width: 900px;
    background: linear-gradient(120deg, var(--fg), color-mix(in srgb, var(--fg) 60%, var(--a1)));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .lead {
    margin-top: 28px;
    font-size: clamp(16px, 2vw, 19px);
    line-height: 1.6;
    color: var(--mute);
    max-width: 680px;
  }
  .services {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    margin-top: 28px;
  }
  .services li {
    font-size: 13.5px;
    font-weight: 600;
    padding: 9px 14px;
    border-radius: 999px;
  }
  .grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 28px;
  }
  @media (min-width: 640px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 960px) {
    .grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .about-body {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
    align-items: start;
  }
  @media (min-width: 900px) {
    .about-body {
      grid-template-columns: 2fr 1fr;
      gap: 48px;
    }
  }
  .about-body p {
    font-size: clamp(17px, 2vw, 20px);
    line-height: 1.6;
  }
  .who {
    display: flex;
    flex-direction: column;
    gap: 4px;
    border-radius: 16px;
    padding: 20px;
    font-size: 15px;
  }
  .who span {
    color: var(--mute);
  }
  .contacts {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
  }
  @media (min-width: 900px) {
    .contacts {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .c {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 22px;
    border-radius: 16px;
    transition: border-color 0.15s;
    overflow-wrap: anywhere;
  }
  .c:hover {
    border-color: var(--a1);
  }
  .k {
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--mute);
  }
  .v {
    font-weight: 600;
    font-size: 15px;
  }
</style>
