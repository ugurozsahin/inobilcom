---
import '../styles/global.css';
import { site } from '../data/site';
import Logo from '../components/Logo.astro';
import JsonLd from '../components/JsonLd.astro';
import { organizationSchema, personSchema, websiteSchema } from '../lib/schema';

interface Props {
  title?: string;
  description?: string;
  /** Absolute or site-relative URL of the social share image. */
  image?: string;
  /** Extra schema.org objects for this page (Organization, Person and WebSite are always included). */
  schema?: Record<string, unknown>[];
}

const { title, description = site.description, image = '/og.png', schema = [] } = Astro.props;
const ogImage = new URL(image, Astro.site);
const pageTitle = title ? `${title} — ${site.name}` : `${site.name} — ${site.hero.headline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="author" content={site.about.person} />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f6f7fb" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0a0b14" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name} — ${site.hero.headline}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <JsonLd data={[organizationSchema, personSchema, websiteSchema, ...schema]} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="nav glass">
      <div class="nav-inner">
        <a class="brand" href="/" aria-label="Inobil home"><Logo height={20} /></a>
        <nav aria-label="Main">
          <a href="/#work">Work</a>
          <a href="/#about">About</a>
          <a href="/#contact">Contact</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer>
      <div class="wrap footer-inner">
        <span>© {year} {site.name}</span>
        <span>Built with Markdown, git and Claude Code</span>
      </div>
    </footer>
  </body>
</html>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 10;
    border-left: 0;
    border-right: 0;
    border-top: 0;
    background: color-mix(in srgb, var(--bg) 70%, transparent);
  }
  .nav-inner {
    max-width: 1244px;
    margin: 0 auto;
    padding: 16px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  @media (min-width: 640px) {
    .nav-inner {
      padding: 18px 32px;
    }
  }
  .brand {
    display: inline-flex;
    align-items: center;
    color: var(--fg);
  }
  nav {
    display: flex;
    gap: 4px;
    font-size: 15px;
  }
  nav a {
    color: var(--mute);
    font-weight: 500;
    padding: 8px 12px;
    border-radius: 999px;
    transition: background 0.15s, color 0.15s;
  }
  nav a:hover {
    background: var(--card);
    color: var(--fg);
  }
  footer {
    border-top: 1px solid var(--line);
    color: var(--mute);
    font-size: 13px;
  }
  .footer-inner {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    padding-top: 32px;
    padding-bottom: 40px;
  }
</style>
